# ServiceNow Configuration
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password
SERVICENOW_INSTANCE_NAME=default
SERVICENOW_AUTH_TYPE=basic

# Server Configuration
PORT=3000
DEBUG=true

# API key authentication for /mcp and /instances: off | warn | enforce
AVANADE_MCP_AUTH_MODE=off
# Hashed key file (default: config/api-keys.json). Manage with: npm run keys -- create --label <name>
AVANADE_MCP_API_KEYS_FILE=
